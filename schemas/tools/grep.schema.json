{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "grep.schema.json",
  "title": "Grep Metadata — Tier 3 (Minimal)",
  "description": "Minimal metadata for the Grep tool (content search). Only source and provenance are carried.",
  "allOf": [{ "$ref": "../base/base-metadata.schema.json" }],
  "required": ["source", "provenance"],
  "notes": {
    "provenance": "Only session_id, caller_type, caller_name required.",
    "koth": "NOT applicable — omit.",
    "decision": "NOT applicable — omit."
  }
}
